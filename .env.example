# 本地开发环境变量样例
# 复制为 .env 后按实际环境填写；.env 已在 .gitignore 中，不入库。
#
# 口径：连接参数一律离散注入（用户 / 口令 / 主机 / 端口 / 库名分开），
# 任何单条配置都不含完整凭证串；如需整体覆盖可用 CRM_DATABASE_URL。

CRM_DB_USER=crm
CRM_DB_PASSWORD=put-your-local-password-here
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=55432
CRM_DB_NAME=crm
CRM_TEST_DB_NAME=crm_test
CRM_REDIS_URL=redis://127.0.0.1:6379/0

# 可选
# CRM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
# CRM_MATRIX_PATH=./crm/permissions/matrix/opportunity.yaml
# CRM_SQL_ECHO=1
